{
  "name": "strad-server-bundle-google",
  "version": "0.1.0",
  "private": true,
  "description": "strad supplementary image: gmail, google-calendar, google-docs and google-sheets MCP servers served over Streamable HTTP from one container.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "vendor/mcp-elicitation",
    "vendor/gmail-shared",
    "vendor/google-calendar-shared",
    "vendor/google-docs-shared",
    "vendor/google-sheets-shared",
    "vendor/google-drive-shared",
    "vendor/google-search-console-shared"
  ],
  "scripts": {
    "build:deps": "npm run build -w @pulsemcp/mcp-elicitation -w gmail-workspace-mcp-server-shared -w google-calendar-workspace-mcp-server-shared -w google-docs-workspace-mcp-server-shared -w google-sheets-workspace-mcp-server-shared -w google-drive-workspace-mcp-server-shared -w google-search-console-workspace-mcp-server-shared",
    "build": "npm run build:deps && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@pulsemcp/mcp-elicitation": "*",
    "express": "^4.21.2",
    "gmail-workspace-mcp-server-shared": "*",
    "google-calendar-workspace-mcp-server-shared": "*",
    "google-docs-workspace-mcp-server-shared": "*",
    "google-drive-workspace-mcp-server-shared": "*",
    "google-search-console-workspace-mcp-server-shared": "*",
    "google-sheets-workspace-mcp-server-shared": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
