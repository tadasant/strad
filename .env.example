# Local development. In a real deployment every SECRET below is injected by CI
# from GCP Secret Manager (`strad-<env>-<NAME>`) as an App Platform SECRET env
# var — the container never holds a cloud credential of its own.

# The config document, inline. The stock image ships zero servers; this is how a
# deployment supplies its own without rebuilding.
# STRAD_CONFIG_YAML=

# System tokens: a JSON array of token records. Mint with `npm run token:mint`.
STRAD_TOKENS=[]

# --- console auth ---
# Google OAuth. When these are set, /console uses real OAuth and the dev bypass
# becomes unnecessary.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The console dev bypass. All THREE must line up, and it still cannot touch /mcp.
ALLOW_DEV_AUTH=true
ADMIN_BOOTSTRAP_TOKEN=change-me

# Shared secret between the core and its internal bundle components.
STRAD_INTERNAL_TOKEN=change-me
