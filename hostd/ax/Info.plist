<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Linked INTO the strad-hostd-ax binary (the __TEXT,__info_plist section; see
  Package.swift), so the helper has a bundle identity without being an .app.
  macOS's System Settings › Menu Bar › "Allow in the Menu Bar" and menu-bar
  managers such as Bartender remember a status item under its owner's bundle
  identifier, and a binary without one has nothing stable to be remembered
  by. CFBundleIdentifier matches the signing identifier
  (install/sign-helper.sh), so the designated requirement the TCC grants are
  keyed on does not change. The name stays strad-hostd-ax, the name the
  grant prompts and System Settings already show. Package.swift does not
  track this file: after editing it, `swift package clean` before building.
-->
<plist version="1.0">
  <dict>
    <key>CFBundleIdentifier</key><string>com.strad.hostd-ax</string>
    <key>CFBundleName</key><string>strad-hostd-ax</string>
    <key>CFBundleDisplayName</key><string>strad-hostd-ax</string>
    <key>CFBundleExecutable</key><string>strad-hostd-ax</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>0.1.0</string>
    <key>LSUIElement</key><true/>
  </dict>
</plist>
