<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A LaunchAgent, not a LaunchDaemon. A daemon runs as root, before login, outside
  any GUI session: it cannot show the consent dialog, cannot reach the user's
  Chrome, and would run remote shell commands as root. An agent runs as the user,
  inside their login session, and stops when they log out.
-->
<plist version="1.0">
  <dict>
    <key>Label</key><string>com.strad.hostd</string>
    <key>ProgramArguments</key>
    <array>
      <string>__NODE__</string>
      <string>__CLI__</string>
      <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>STRAD_HOSTD_HOME</key><string>__STATE__</string>
      <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/com.strad.hostd.out.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/com.strad.hostd.err.log</string>
  </dict>
</plist>
