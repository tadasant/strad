<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  strad-hostd-ax as its OWN LaunchAgent, beside com.strad.hostd, and not as a
  child of it. macOS attributes a process's privacy grants (Accessibility,
  Screen Recording) to its "responsible process", which a child inherits from
  its parent and which launchd resets for a process it starts itself. Spawned
  by the daemon, the helper's grants would land on `node` and cover every Node
  script on the machine; started by launchd, they land on this binary.
  The daemon reaches it over the Unix socket in the state directory.
-->
<plist version="1.0">
  <dict>
    <key>Label</key><string>com.strad.hostd-ax</string>
    <key>ProgramArguments</key>
    <array>
      <string>__HELPER__</string>
      <string>--listen</string>
      <string>__STATE__/ax.sock</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/com.strad.hostd-ax.out.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/com.strad.hostd-ax.err.log</string>
  </dict>
</plist>
